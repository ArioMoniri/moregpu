{
  "version": 1,
  "schema": "moregpu.opgraph/1",
  "doc": "docs/WEBGPU_VISION.md",
  "conventions": {
    "graph": "{version:1, inputs:[{name,shape}], nodes:[{op,inputs,attrs,output}], outputs:[name...], weights:'<file>.safetensors'}",
    "op": "ATen name 'aten.<name>' optionally followed by '.<overload>' (e.g. 'aten.add.Tensor', 'aten.conv3d.default'). The executor matches on 'aten.<name>'.",
    "inputs": "Tensor arguments in ATen-schema order, as value names (graph inputs, earlier node outputs or safetensors weight names). An absent optional tensor is null. Trailing nulls may be dropped. A Tensor[] argument (aten.cat) is flattened in place.",
    "attrs": "Every non-tensor argument keyed by its ATen schema argument name, defaults filled. A Python number passed in a Tensor slot (x * 0.5) is given in attrs under that argument's name (e.g. 'other'). Non-finite floats are the strings 'Infinity', '-Infinity', 'NaN' (strict JSON; parsed by Python float() and JS Number()).",
    "multi_output": "Ops that return tuples (native_layer_norm, native_group_norm, _native_batch_norm_legit_no_training, max_pool*_with_indices) produce ONLY output 0 under 'output'; the lowering maps getitem(node, 0) to that name and must not reference other outputs.",
    "dtypes": "All values are float32 at the interface (weights may be F32/F16/BF16 in safetensors; they are widened). argmax yields float32 indices.",
    "shapes": "Static. Graph input shapes are fixed at load time; every node output is contiguous row-major."
  },
  "ops": {
    "aten.convolution": { "kind": "conv", "inputs": ["input", "weight", "bias?"], "attrs": ["stride", "padding", "dilation", "transposed", "output_padding", "groups"], "notes": "2D or 3D (rank of weight). transposed=true is the gather-form transposed conv." },
    "aten.conv2d": { "kind": "conv", "inputs": ["input", "weight", "bias?"], "attrs": ["stride", "padding", "dilation", "groups"], "notes": "padding must be an int list (string 'same'/'valid' unsupported)" },
    "aten.conv3d": { "kind": "conv", "inputs": ["input", "weight", "bias?"], "attrs": ["stride", "padding", "dilation", "groups"] },
    "aten.conv_transpose2d": { "kind": "conv_transpose", "inputs": ["input", "weight", "bias?"], "attrs": ["stride", "padding", "output_padding", "groups", "dilation"] },
    "aten.conv_transpose3d": { "kind": "conv_transpose", "inputs": ["input", "weight", "bias?"], "attrs": ["stride", "padding", "output_padding", "groups", "dilation"] },
    "aten.linear": { "kind": "matmul", "inputs": ["input", "weight", "bias?"], "attrs": [] },
    "aten.addmm": { "kind": "matmul", "inputs": ["self", "mat1", "mat2"], "attrs": ["beta", "alpha"] },
    "aten.mm": { "kind": "matmul", "inputs": ["self", "mat2"], "attrs": [] },
    "aten.bmm": { "kind": "matmul", "inputs": ["self", "mat2"], "attrs": [] },
    "aten.matmul": { "kind": "matmul", "inputs": ["self", "other"], "attrs": [], "notes": "rank>=2 operands; batch dims broadcast when one side's batch is 1 or absent" },
    "aten.scaled_dot_product_attention": { "kind": "attention", "inputs": ["query", "key", "value"], "attrs": ["dropout_p", "is_causal", "scale", "enable_gqa"], "notes": "attn_mask unsupported; dropout_p must be 0; head_dim <= 256" },
    "aten.batch_norm": { "kind": "norm", "inputs": ["input", "weight?", "bias?", "running_mean", "running_var"], "attrs": ["training", "momentum", "eps", "cudnn_enabled"], "notes": "eval only (training=false); folded to a per-channel scale/shift at load" },
    "aten._native_batch_norm_legit_no_training": { "kind": "norm", "inputs": ["input", "weight?", "bias?", "running_mean", "running_var"], "attrs": ["momentum", "eps"] },
    "aten.instance_norm": { "kind": "norm", "inputs": ["input", "weight?", "bias?", "running_mean?", "running_var?"], "attrs": ["use_input_stats", "momentum", "eps", "cudnn_enabled"], "notes": "use_input_stats=true (running stats ignored), which is what InstanceNorm*d does by default" },
    "aten.group_norm": { "kind": "norm", "inputs": ["input", "weight?", "bias?"], "attrs": ["num_groups", "eps", "cudnn_enabled"] },
    "aten.native_group_norm": { "kind": "norm", "inputs": ["input", "weight?", "bias?"], "attrs": ["N", "C", "HxW", "group", "eps"] },
    "aten.layer_norm": { "kind": "norm", "inputs": ["input", "weight?", "bias?"], "attrs": ["normalized_shape", "eps", "cudnn_enable"] },
    "aten.native_layer_norm": { "kind": "norm", "inputs": ["input", "weight?", "bias?"], "attrs": ["normalized_shape", "eps"] },
    "aten.max_pool2d": { "kind": "pool", "inputs": ["self"], "attrs": ["kernel_size", "stride", "padding", "dilation", "ceil_mode"], "notes": "ceil_mode=false only; empty stride means stride=kernel_size" },
    "aten.max_pool3d": { "kind": "pool", "inputs": ["self"], "attrs": ["kernel_size", "stride", "padding", "dilation", "ceil_mode"] },
    "aten.max_pool2d_with_indices": { "kind": "pool", "inputs": ["self"], "attrs": ["kernel_size", "stride", "padding", "dilation", "ceil_mode"], "notes": "output 0 (values) only" },
    "aten.max_pool3d_with_indices": { "kind": "pool", "inputs": ["self"], "attrs": ["kernel_size", "stride", "padding", "dilation", "ceil_mode"], "notes": "output 0 (values) only" },
    "aten.avg_pool2d": { "kind": "pool", "inputs": ["self"], "attrs": ["kernel_size", "stride", "padding", "ceil_mode", "count_include_pad", "divisor_override"], "notes": "ceil_mode=false; divisor_override null or int" },
    "aten.avg_pool3d": { "kind": "pool", "inputs": ["self"], "attrs": ["kernel_size", "stride", "padding", "ceil_mode", "count_include_pad", "divisor_override"] },
    "aten.adaptive_avg_pool2d": { "kind": "pool", "inputs": ["self"], "attrs": ["output_size"], "notes": "each spatial size must be divisible by its output size (lowered to avg_pool with kernel = stride = in/out)" },
    "aten.adaptive_avg_pool3d": { "kind": "pool", "inputs": ["self"], "attrs": ["output_size"], "notes": "divisible sizes only (as adaptive_avg_pool2d)" },
    "aten.upsample_nearest2d": { "kind": "upsample", "inputs": ["input"], "attrs": ["output_size", "scale_factors"], "notes": ".vec overload attrs; the .default overload's scales_h/scales_w are also accepted" },
    "aten.upsample_nearest3d": { "kind": "upsample", "inputs": ["input"], "attrs": ["output_size", "scale_factors"] },
    "aten.upsample_bilinear2d": { "kind": "upsample", "inputs": ["input"], "attrs": ["output_size", "align_corners", "scale_factors"] },
    "aten.upsample_trilinear3d": { "kind": "upsample", "inputs": ["input"], "attrs": ["output_size", "align_corners", "scale_factors"] },
    "aten.cat": { "kind": "concat", "inputs": ["tensors..."], "attrs": ["dim"], "notes": "implemented with buffer-to-buffer copies (no binding-size limit)" },
    "aten.add": { "kind": "binary", "inputs": ["self", "other|attr"], "attrs": ["alpha", "other"], "notes": "numpy broadcasting up to rank 6" },
    "aten.sub": { "kind": "binary", "inputs": ["self", "other|attr"], "attrs": ["alpha", "other"] },
    "aten.mul": { "kind": "binary", "inputs": ["self", "other|attr"], "attrs": ["other"] },
    "aten.div": { "kind": "binary", "inputs": ["self", "other|attr"], "attrs": ["other", "rounding_mode"], "notes": "rounding_mode must be null" },
    "aten.relu": { "kind": "unary", "inputs": ["self"], "attrs": [] },
    "aten.relu_": { "kind": "unary", "inputs": ["self"], "attrs": [] },
    "aten.leaky_relu": { "kind": "unary", "inputs": ["self"], "attrs": ["negative_slope"] },
    "aten.leaky_relu_": { "kind": "unary", "inputs": ["self"], "attrs": ["negative_slope"] },
    "aten.gelu": { "kind": "unary", "inputs": ["self"], "attrs": ["approximate"], "notes": "'none' (erf, rational approx. <2 ulp) or 'tanh'" },
    "aten.sigmoid": { "kind": "unary", "inputs": ["self"], "attrs": [] },
    "aten.tanh": { "kind": "unary", "inputs": ["self"], "attrs": [] },
    "aten.silu": { "kind": "unary", "inputs": ["self"], "attrs": [] },
    "aten.abs": { "kind": "unary", "inputs": ["self"], "attrs": [] },
    "aten.neg": { "kind": "unary", "inputs": ["self"], "attrs": [] },
    "aten.exp": { "kind": "unary", "inputs": ["self"], "attrs": [] },
    "aten.sqrt": { "kind": "unary", "inputs": ["self"], "attrs": [] },
    "aten.rsqrt": { "kind": "unary", "inputs": ["self"], "attrs": [] },
    "aten.prelu": { "kind": "channel", "inputs": ["self", "weight"], "attrs": [], "notes": "per-channel (dim 1) or single slope" },
    "aten._softmax": { "kind": "softmax", "inputs": ["self"], "attrs": ["dim", "half_to_float"] },
    "aten.softmax": { "kind": "softmax", "inputs": ["self"], "attrs": ["dim", "dtype"] },
    "aten.argmax": { "kind": "argmax", "inputs": ["self"], "attrs": ["dim", "keepdim"], "notes": "dim required; first maximal index; float32 output" },
    "aten.mean": { "kind": "reduce", "inputs": ["self"], "attrs": ["dim", "keepdim", "dtype"], "notes": "reduced dims must be contiguous in the shape" },
    "aten.view": { "kind": "view", "inputs": ["self"], "attrs": ["size"] },
    "aten.reshape": { "kind": "view", "inputs": ["self"], "attrs": ["shape"] },
    "aten._unsafe_view": { "kind": "view", "inputs": ["self"], "attrs": ["size"] },
    "aten.flatten": { "kind": "view", "inputs": ["self"], "attrs": ["start_dim", "end_dim"] },
    "aten.unsqueeze": { "kind": "view", "inputs": ["self"], "attrs": ["dim"] },
    "aten.squeeze": { "kind": "view", "inputs": ["self"], "attrs": ["dim"] },
    "aten.contiguous": { "kind": "view", "inputs": ["self"], "attrs": ["memory_format"] },
    "aten.clone": { "kind": "view", "inputs": ["self"], "attrs": ["memory_format"] },
    "aten.alias": { "kind": "view", "inputs": ["self"], "attrs": [] },
    "aten.detach": { "kind": "view", "inputs": ["self"], "attrs": [] },
    "aten.dropout": { "kind": "view", "inputs": ["input"], "attrs": ["p", "train"], "notes": "identity (inference)" },
    "aten.permute": { "kind": "copy", "inputs": ["self"], "attrs": ["dims"] },
    "aten.transpose": { "kind": "copy", "inputs": ["self"], "attrs": ["dim0", "dim1"] },
    "aten.t": { "kind": "copy", "inputs": ["self"], "attrs": [] },
    "aten.expand": { "kind": "copy", "inputs": ["self"], "attrs": ["size", "implicit"] },
    "aten.select": { "kind": "copy", "inputs": ["self"], "attrs": ["dim", "index"] },
    "aten.slice": { "kind": "copy", "inputs": ["self"], "attrs": ["dim", "start", "end", "step"] },
    "aten.pad": { "kind": "pad", "inputs": ["self"], "attrs": ["pad", "mode", "value"], "notes": "mode constant | replicate | reflect" },
    "aten.constant_pad_nd": { "kind": "pad", "inputs": ["self"], "attrs": ["pad", "value"] }
  }
}
