#!/usr/bin/env bash
# moregpu — one CLI to run, join, control, and monitor a MoreGPU pool (admin server or worker).
# Run with no arguments for an interactive menu; or use the subcommands directly (see `moregpu help`).
#   curl -fsSL https://raw.githubusercontent.com/ArioMoniri/moregpu/main/scripts/moregpu -o /usr/local/bin/moregpu && chmod +x /usr/local/bin/moregpu
set -euo pipefail

REPO="${MOREGPU_REPO:-ArioMoniri/moregpu}"; BRANCH="${MOREGPU_BRANCH:-main}"
RAW="https://raw.githubusercontent.com/${REPO}/${BRANCH}"
SERVER_TS="$RAW/apps/coordinator/server.ts"
WORKER_TS="$RAW/apps/worker/worker.ts"
VERSION="v0.6.0"

# ---- colors (disabled when not a TTY, NO_COLOR is set, or the terminal has < 8 colors) ----
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ] && [ "$(tput colors 2>/dev/null || echo 0)" -ge 8 ]; then CLR=1; else CLR=0; fi
c()  { [ "$CLR" = 1 ] && printf '\033[%sm' "$1" || true; }        # raw SGR
rst(){ [ "$CLR" = 1 ] && printf '\033[0m' || true; }
dim(){ c 2; printf '%s' "$1"; rst; }
b()  { c '1'; printf '%s' "$1"; rst; }
red(){ c '38;5;203'; printf '%s' "$1"; rst; }
pnk(){ c '38;5;205'; printf '%s' "$1"; rst; }
grn(){ c '38;5;42';  printf '%s' "$1"; rst; }

# ---- SCOUT-style gradient wordmark (ANSI Shadow "MOREGPU", indigo→pink→red) ----
wordmark() {
  local cols=(63 99 135 171 205 203)
  local r0='███╗   ███╗ ██████╗ ██████╗ ███████╗ ██████╗ ██████╗ ██╗   ██╗'
  local r1='████╗ ████║██╔═══██╗██╔══██╗██╔════╝██╔════╝ ██╔══██╗██║   ██║'
  local r2='██╔████╔██║██║   ██║██████╔╝█████╗  ██║  ███╗██████╔╝██║   ██║'
  local r3='██║╚██╔╝██║██║   ██║██╔══██╗██╔══╝  ██║   ██║██╔═══╝ ██║   ██║'
  local r4='██║ ╚═╝ ██║╚██████╔╝██║  ██║███████╗╚██████╔╝██║     ╚██████╔╝'
  local r5='╚═╝     ╚═╝ ╚═════╝ ╚═╝  ╚═╝╚══════╝ ╚═════╝ ╚═╝      ╚═════╝ '
  local rows=("$r0" "$r1" "$r2" "$r3" "$r4" "$r5") i
  printf '\n'
  for i in 0 1 2 3 4 5; do
    if [ "$CLR" = 1 ]; then printf '  \033[38;5;%sm%s\033[0m\n' "${cols[$i]}" "${rows[$i]}"; else printf '  %s\n' "${rows[$i]}"; fi
  done
}

rule() { local w="${1:-64}"; c '38;5;205'; printf '  '; printf '─%.0s' $(seq 1 "$w"); rst; printf '\n'; }

banner() {
  wordmark
  printf '  '; dim "$VERSION"; printf '  ·  '; b 'GPU compute pool'; printf '\n'
  printf '  '; dim "github.com/${REPO}"; printf '  ·  '; dim 'sealed'; printf ' '; grn 'AES-256-GCM'; printf '\n\n'
}

# menu cell "[n] Name  desc" — colored, then padded (by VISIBLE width) so columns align.
LCELLW=36
cell() { # n name desc  [padto]
  printf '   '; c '38;5;203'; printf '[%s]' "$1"; rst; printf ' '; b "$2"; [ -n "$3" ] && { printf '  '; dim "$3"; }
  if [ -n "${4:-}" ]; then
    local vis="[$1] $2"; [ -n "$3" ] && vis="$vis  $3"
    local n=$(( 3 + $4 - ${#vis} )); [ "$n" -lt 1 ] && n=1
    printf '%*s' "$n" ''
  fi
}
sec() { printf '  '; c '38;5;205'; b "$1"; rst; [ -n "${2:-}" ] && { printf '  '; dim "$2"; }; printf '\n'; }

menu_screen() {
  banner
  sec 'Pool'
  cell 1 'Serve'        'admin server'      "$LCELLW"; cell 4 'Isolate' 'bounded worker (Linux)'; printf '\n'
  cell 2 'Serve+Worker' 'this machine too'  "$LCELLW"; cell 5 'Monitor' 'device + workers';       printf '\n'
  cell 3 'Join'         'lend this machine'; printf '\n\n'
  sec 'Fleet' '(needs MOREGPU_SERVER + MOREGPU_ADMIN_TOKEN)'
  cell 6 'Workers'      'list'              "$LCELLW"; cell 8 'Set duty' 'cap a worker'; printf '\n'
  cell 7 'Pause/Resume' 'a worker'          "$LCELLW"; cell 9 'Remove'   'kick a worker'; printf '\n\n'
  sec 'Service'
  cell 10 'Install'     'reboot-surviving'  "$LCELLW"; cell 12 'Status' ''; printf '\n'
  cell 11 'Stop'        ''                  "$LCELLW"; cell 13 'Logs'   ''; printf '\n\n'
  cell 0 'Exit' ''; printf '\n\n'
}

# Prompt to STDERR (so it shows on the terminal) and echo ONLY the entered value on stdout for $( ) capture.
ask()        { local p="$1" v; { printf '  '; c '38;5;205'; printf '%s' "$p"; rst; } >&2; read -r v; printf '%s' "$v"; }
ask_secret() { local p="$1" v; { printf '  '; c '38;5;205'; printf '%s' "$p"; rst; } >&2; read -rs v; printf '\n' >&2; printf '%s' "$v"; }  # no echo (tokens)

interactive_menu() {
  while true; do
    clear 2>/dev/null || true
    menu_screen
    printf '  '; c '38;5;205'; printf '❯ '; rst
    read -r choice || { echo; exit 0; }
    case "$choice" in
      1) exec "$0" serve ;;
      2) exec "$0" serve --worker ;;
      3) s="$(ask 'server (wss://HOST:8787/ws): ')"; t="$(ask_secret 'join token: ')"; exec "$0" join --server "$s" --token "$t" ;;
      4) s="$(ask 'server (wss://HOST:8787/ws): ')"; t="$(ask_secret 'join token: ')"; exec "$0" isolate --server "$s" --token "$t" ;;
      5) "$0" monitor || true; ;;
      6) "$0" workers || true; ;;
      7) id="$(ask 'worker id: ')"; a="$(ask 'action (pause/resume): ')"; "$0" "$a" "$id" || true ;;
      8) id="$(ask 'worker id: ')"; d="$(ask 'duty ceiling (0.05-1): ')"; "$0" set "$id" "$d" || true ;;
      9) id="$(ask 'worker id to remove: ')"; "$0" rm "$id" || true ;;
      10) exec "$0" install ;;
      11) "$0" stop || true ;;
      12) "$0" status || true ;;
      13) exec "$0" logs ;;
      0|q|Q) exit 0 ;;
      *) ;;
    esac
    printf '\n  '; dim 'press Enter to continue…'; read -r _ || exit 0
  done
}

need_deno() {
  command -v deno >/dev/null 2>&1 && return 0
  echo "[moregpu] Deno is required. Install: curl -fsSL https://deno.land/install.sh | sh" >&2; exit 1
}

# Resolve the admin HTTP base from MOREGPU_SERVER (accepts ws/wss/http/https, with or without /ws).
mg_base() { local x="${MOREGPU_SERVER:-http://localhost:8787}"; x="${x%/ws}"; x="${x/wss:/https:}"; x="${x/ws:/http:}"; echo "$x"; }
mg_ctl()  { # <worker-id> <json-body> — POST an admin control frame
  [ $# -ge 2 ] || { echo "[moregpu] usage: moregpu <pause|resume|set|rm> <worker-id> [value]" >&2; exit 2; }
  curl -fsS -X POST "$(mg_base)/workers/$1/control" \
    -H "authorization: Bearer ${MOREGPU_ADMIN_TOKEN:-}" -H 'content-type: application/json' -d "$2"; echo
}

# serve, with optional --host (advertise a reachable name) and --tunnel (auto-expose over a real-cert tunnel so
# REMOTE machines can join with NO pin — the whole no-code "start a pool anyone can join" path in one command).
cmd_serve() {
  need_deno
  local host="" tunnel=0; local pass=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --host) host="$2"; shift 2 ;;
      --host=*) host="${1#--host=}"; shift ;;
      --tunnel) tunnel=1; shift ;;
      --port) export PORT="$2"; shift 2 ;;
      --port=*) export PORT="${1#--port=}"; shift ;;
      *) pass+=("$1"); shift ;;
    esac
  done
  [ -n "$host" ] && export MOREGPU_HOST="$host"
  local port="${PORT:-8787}"
  if [ "$tunnel" != "1" ]; then
    exec deno run --allow-net --allow-env --allow-read --allow-write --allow-run --allow-sys "$SERVER_TS" ${pass[@]+"${pass[@]}"}
  fi
  local tun=""
  command -v cloudflared >/dev/null 2>&1 && tun=cloudflared
  [ -z "$tun" ] && command -v ngrok >/dev/null 2>&1 && tun=ngrok
  [ -z "$tun" ] && { echo "[moregpu] --tunnel needs cloudflared (preferred) or ngrok on PATH." >&2
    echo "           macOS: brew install cloudflared  ·  Linux: https://developers.cloudflare.com/cloudflared/" >&2; exit 1; }
  local cfg="${MOREGPU_CONFIG:-./.moregpu-server.json}"
  echo "[moregpu] starting coordinator behind $tun on :$port (plaintext ws:// — the tunnel terminates TLS)…"
  MOREGPU_INSECURE=1 MOREGPU_BIND=127.0.0.1 PORT="$port" MOREGPU_CONFIG="$cfg" \
    deno run --allow-net --allow-env --allow-read --allow-write --allow-run --allow-sys "$SERVER_TS" --worker ${pass[@]+"${pass[@]}"} &
  local coord=$! i tlog="" tunpid=""
  # Arm cleanup BEFORE the waits/polls below so a Ctrl-C during startup tears down the coordinator + tunnel
  # instead of orphaning them on the bound port. (${var:-} because tunpid/tlog aren't set yet at this point.)
  trap 'kill ${coord:-} ${tunpid:-} 2>/dev/null; [ -n "${tlog:-}" ] && rm -f "$tlog"; exit 0' INT TERM
  for i in $(seq 1 60); do curl -fsS "http://localhost:$port/health" >/dev/null 2>&1 && break; sleep 0.5; done
  tlog="$(mktemp)"
  if [ "$tun" = cloudflared ]; then cloudflared tunnel --url "http://localhost:$port" --no-autoupdate >"$tlog" 2>&1 &
  else ngrok http "$port" --log=stdout >"$tlog" 2>&1 & fi
  tunpid=$!; local url=""
  for i in $(seq 1 40); do
    # `|| true`: under `set -euo pipefail` a no-match grep exits 1 and pipefail would abort the whole
    # command (killing the poll + orphaning coord/tunnel) — a not-yet-published URL is expected, not fatal.
    url="$(grep -oE 'https://[a-z0-9._-]+\.(trycloudflare\.com|ngrok[-a-z.]*)' "$tlog" 2>/dev/null | head -1 || true)"
    [ -n "$url" ] && break; sleep 1
  done
  [ -z "$url" ] && { echo "[moregpu] tunnel did not come up — see $tlog" >&2; wait "$coord"; return; }
  local join; join="$(deno eval "console.log(JSON.parse(Deno.readTextFileSync('$cfg')).joinToken)" 2>/dev/null || true)"
  local wss="${url/https:/wss:}"
  echo ""
  echo "  ============================================================================"
  echo "  MoreGPU pool is LIVE behind a tunnel — public URL: $url"
  echo "  Add a worker on ANY machine (no pin — the tunnel presents a real cert):"
  echo "     curl -fsSL $RAW/scripts/install.sh | MOREGPU_SERVER=$wss/ws MOREGPU_TOKEN=$join sh"
  echo "  Dashboard: open $url   (admin token is in $cfg)"
  echo "  Ctrl-C to stop the pool + tunnel."
  echo "  ============================================================================"
  wait "$coord"
}

# no-code fine-tune / inference (finetune|generate|chat) — drives the pool's train + serve API so users
# never hand-write a training loop. Runs the local driver in a clone, else fetches it from the repo. Only
# the URL is injected on argv (BEFORE the subcommand — argparse needs the top-level flag first); the admin
# token is passed via the INHERITED ENVIRONMENT (not argv, which is world-readable via ps/proc) — the driver
# reads MOREGPU_ADMIN_TOKEN from env, or the adminToken from ./.moregpu-server.json.
ml_run() {
  command -v python3 >/dev/null 2>&1 || { echo "[moregpu] fine-tuning/inference needs python3 (+ torch & transformers on the worker)." >&2; exit 1; }
  local self_dir local_py conn=(--url "$(mg_base)")
  self_dir="$(cd "$(dirname "$0")" 2>/dev/null && pwd || echo .)"
  local_py="$self_dir/moregpu_ml.py"
  [ -n "${MOREGPU_ADMIN_TOKEN:-}" ] && export MOREGPU_ADMIN_TOKEN   # ensure the driver inherits it, off argv
  if [ -f "$local_py" ]; then exec python3 "$local_py" ${conn[@]+"${conn[@]}"} "$@"; fi
  local f; f="$(mktemp)"; trap 'rm -f "$f"' EXIT
  curl -fsSL "$RAW/scripts/moregpu_ml.py" -o "$f" || { echo "[moregpu] failed to fetch moregpu_ml.py" >&2; exit 1; }
  [ -s "$f" ] || { echo "[moregpu] fetched moregpu_ml.py is empty" >&2; exit 1; }
  exec python3 "$f" ${conn[@]+"${conn[@]}"} "$@"
}

cmd="${1:-__menu__}"; [ $# -gt 0 ] && shift || true

case "$cmd" in
  __menu__) if [ -t 0 ] && [ -t 1 ]; then interactive_menu; else "$0" help; fi ;;

  serve)   cmd_serve "$@" ;;
  join)    need_deno; exec deno run --unstable-webgpu --allow-net --allow-env --allow-sys "$WORKER_TS" "$@" ;;
  install) exec sh -c "curl -fsSL $RAW/scripts/install.sh | MOREGPU_SERVICE=1 sh" ;;

  finetune|generate|chat) ml_run "$cmd" "$@" ;;

  isolate) need_deno
    command -v bash >/dev/null 2>&1 || { echo "[moregpu] isolate needs bash (Linux, systemd + cgroups v2)"; exit 1; }
    f="$(mktemp)"; trap 'rm -f "$f"' EXIT
    curl -fsSL "$RAW/scripts/isolate-linux.sh" -o "$f" || { echo "[moregpu] failed to fetch isolate-linux.sh" >&2; exit 1; }
    [ -s "$f" ] || { echo "[moregpu] fetched isolate-linux.sh is empty" >&2; exit 1; }
    exec bash "$f" deno run --unstable-webgpu --allow-net --allow-env --allow-sys "$WORKER_TS" "$@" ;;

  stop)
    if command -v systemctl >/dev/null 2>&1 && systemctl --user is-active --quiet moregpu-worker 2>/dev/null; then
      systemctl --user stop moregpu-worker && echo "[moregpu] worker service stopped."
    elif [ "$(uname -s)" = "Darwin" ] && launchctl list 2>/dev/null | grep -q dev.moregpu.worker; then
      launchctl unload "$HOME/Library/LaunchAgents/dev.moregpu.worker.plist" && echo "[moregpu] worker agent stopped."
    elif command -v tmux >/dev/null 2>&1 && tmux has-session -t moregpu 2>/dev/null; then
      tmux kill-session -t moregpu && echo "[moregpu] tmux worker session killed."
    else echo "[moregpu] no installed service found. A foreground worker stops with Ctrl-C."; fi ;;

  status)
    if command -v systemctl >/dev/null 2>&1; then systemctl --user status moregpu-worker --no-pager 2>/dev/null || echo "[moregpu] no systemd user service.";
    elif [ "$(uname -s)" = "Darwin" ]; then launchctl list 2>/dev/null | grep dev.moregpu.worker || echo "[moregpu] launchd agent not loaded.";
    else echo "[moregpu] status: check your process manager."; fi ;;

  logs)
    if command -v journalctl >/dev/null 2>&1; then journalctl --user -u moregpu-worker -f;
    else echo "[moregpu] logs: foreground workers print to their terminal; services log to the OS log."; fi ;;

  # ---- admin fleet control (needs MOREGPU_SERVER + MOREGPU_ADMIN_TOKEN) ----
  workers) curl -fsS "$(mg_base)/workers" -H "authorization: Bearer ${MOREGPU_ADMIN_TOKEN:-}" ;;
  pause)   mg_ctl "${1:-}" '{"action":"pause"}' ;;
  resume)  mg_ctl "${1:-}" '{"action":"resume"}' ;;
  set)     case "${2:-}" in ''|*[!0-9.]*) echo "[moregpu] duty must be a number 0.05-1" >&2; exit 2;; esac
           mg_ctl "${1:-}" "{\"ceil\":${2}}" ;;
  schedule) case "${2:-always}" in always|idle-only|[0-2][0-9]:[0-5][0-9]-[0-2][0-9]:[0-5][0-9]) : ;; *) echo "[moregpu] schedule must be always | idle-only | HH:MM-HH:MM" >&2; exit 2;; esac
           mg_ctl "${1:-}" "{\"schedule\":\"${2:-always}\"}" ;;
  rm|remove) mg_ctl "${1:-}" '{"action":"remove"}' ;;

  monitor)
    base="$(mg_base)"; tok="${MOREGPU_ADMIN_TOKEN:-}"
    echo "[moregpu] $base/device"; curl -fsS "$base/device" -H "authorization: Bearer $tok" || echo "  (need MOREGPU_ADMIN_TOKEN, and the server reachable)"
    echo; echo "[moregpu] workers:"; curl -fsS "$base/workers" -H "authorization: Bearer $tok" || true ;;

  version) echo "moregpu CLI ${VERSION} (repo $REPO@$BRANCH)" ;;

  menu) interactive_menu ;;

  help|--help|-h|*)
    banner
    cat <<EOF
  RUN A POOL
    moregpu serve [--worker] [--tunnel] [--host H] [--port N]
                                               run the admin server (prints the setup wizard)
                                               --tunnel: auto-expose over cloudflared/ngrok so REMOTE machines
                                                         join with no pin (prints the ready worker one-liner)
                                               --host H: advertise a reachable hostname/IP (not localhost)
    moregpu join --server wss://HOST:8787/ws --token TOK [--cpu] [--schedule 22:00-07:00]
    moregpu isolate --server … --token …       Linux: run pinned to bounded, isolated hardware
    moregpu install | stop | status | logs     the local worker service

  FINE-TUNE & RUN MODELS   (no code; needs a torch worker + python3 with torch/transformers)
    moregpu finetune MODEL [--data FILE] [--steps N] [--out FILE]
                                               LoRA fine-tune on your text; saves the adapter, shows before/after
    moregpu generate MODEL --prompt "…" [--from-training]
                                               run the model; --from-training uses the just-fine-tuned one
    moregpu chat MODEL [--from-training]        interactive chat (one turn per line)

  ADMIN FLEET CONTROL   (env: MOREGPU_SERVER, MOREGPU_ADMIN_TOKEN)
    moregpu workers | monitor                  list workers / pool device
    moregpu pause <id> | resume <id>           pause/resume one worker
    moregpu set <id> <duty> | schedule <id> <spec> | rm <id>

  Run 'moregpu' with no arguments for the interactive menu.
  Docs: https://github.com/$REPO
EOF
    ;;
esac
